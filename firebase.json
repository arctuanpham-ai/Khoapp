{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "web-manager",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }
        ]
      }
    ]
  }
}
