rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isStoreOwner(ownerUid) {
      return signedIn() && request.auth.uid == ownerUid;
    }

    // Future shareholder/manager accounts are granted by an administrator in
    // /managerAccess/{theirUid}. They can read only, never write POS data.
    function hasManagerReadAccess(ownerUid) {
      return signedIn()
        && exists(/databases/$(database)/documents/managerAccess/$(request.auth.uid))
        && get(/databases/$(database)/documents/managerAccess/$(request.auth.uid)).data.ownerUid == ownerUid
        && get(/databases/$(database)/documents/managerAccess/$(request.auth.uid)).data.active == true;
    }

    function hasManagerFinanceWriteAccess(ownerUid) {
      return hasManagerReadAccess(ownerUid)
        && get(/databases/$(database)/documents/managerAccess/$(request.auth.uid)).data.canWriteFinance == true;
    }

    match /users/{ownerUid}/stores/{storeId}/{document=**} {
      allow read: if isStoreOwner(ownerUid) || hasManagerReadAccess(ownerUid);
      allow write: if isStoreOwner(ownerUid);
    }

    // Finance entry from Web Manager is deliberately limited to canonical
    // purchase / financial-movement collections. Managers need explicit grant.
    match /users/{ownerUid}/stores/{storeId}/purchases/{purchaseId} {
      allow create, update: if isStoreOwner(ownerUid) || hasManagerFinanceWriteAccess(ownerUid);
      allow delete: if isStoreOwner(ownerUid);
    }

    match /users/{ownerUid}/stores/{storeId}/purchaseItems/{itemId} {
      allow create, update: if isStoreOwner(ownerUid) || hasManagerFinanceWriteAccess(ownerUid);
      allow delete: if isStoreOwner(ownerUid);
    }

    match /users/{ownerUid}/stores/{storeId}/assets/{assetId} {
      allow create, update: if isStoreOwner(ownerUid) || hasManagerFinanceWriteAccess(ownerUid);
      allow delete: if isStoreOwner(ownerUid);
    }

    match /users/{ownerUid}/stores/{storeId}/suppliers/{supplierId} {
      allow create, update: if isStoreOwner(ownerUid) || hasManagerFinanceWriteAccess(ownerUid);
      allow delete: if isStoreOwner(ownerUid);
    }

    match /users/{ownerUid}/stores/{storeId}/financialMovements/{movementId} {
      allow create, update: if isStoreOwner(ownerUid) || hasManagerFinanceWriteAccess(ownerUid);
      allow delete: if isStoreOwner(ownerUid);
    }

    // Raw Room snapshots can contain staff PINs and other restore-only data.
    // They are deliberately invisible to manager/shareholder accounts.
    match /users/{ownerUid}/privateBackups/{backupId}/{document=**} {
      allow read, write: if isStoreOwner(ownerUid);
    }

    match /managerAccess/{managerUid} {
      allow read: if signedIn() && request.auth.uid == managerUid;
      allow write: if false;
    }
  }
}
